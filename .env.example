# Shared environment template
DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/finance_db
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=s3
STORAGE_BUCKET=finance-platform-dev
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
EMAIL_API_KEY=
MARKET_DATA_API_KEY=
NEWS_API_KEY=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENABLED=false
AI_MAX_REQUESTS_PER_USER=20
AI_GLOBAL_MAX_REQUESTS_PER_DAY=1000
AI_MAX_RESPONSE_TOKENS=600
# Optional; omit to use the model default.
# AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_PROMPT_CHARACTERS=4000
AI_HISTORY_ENABLED_BY_DEFAULT=false
AI_HISTORY_RETENTION_DAYS=30
AI_REQUEST_LOGGING=false
AI_PRIVACY_MODE=true
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_ACCESS_TOKEN=
NOTIFICATION_MAX_ATTEMPTS=5
MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_TOKEN=
MPESA_LIVE_PAYMENTS_ENABLED=false
MARKET_DATA_PROVIDER=alpha_vantage
EXCHANGE_RATE_PROVIDER=frankfurter_ecb
ALPHA_VANTAGE_API_KEY=
NEWS_PROVIDER=unconfigured
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","exp://192.168.1.10:8081"]

# Docker overrides
POSTGRES_DB=finance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-password
