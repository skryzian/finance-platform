# Shared environment template
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finance_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=s3
STORAGE_BUCKET=finance-platform-dev
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
EMAIL_API_KEY=replace-me
MARKET_DATA_API_KEY=replace-me
NEWS_API_KEY=replace-me
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_ENABLED=false
AI_MAX_REQUESTS_PER_USER=20
AI_GLOBAL_MAX_REQUESTS_PER_DAY=1000
AI_MAX_RESPONSE_TOKENS=600
# Optional; omit to use the model default.
# AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_PROMPT_CHARACTERS=4000
AI_HISTORY_ENABLED_BY_DEFAULT=false
AI_HISTORY_RETENTION_DAYS=30
AI_REQUEST_LOGGING=false
AI_PRIVACY_MODE=true
MARKET_DATA_PROVIDER=unconfigured
EXCHANGE_RATE_PROVIDER=unconfigured
NEWS_PROVIDER=unconfigured
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","exp://192.168.1.10:8081"]

# Docker overrides
POSTGRES_DB=finance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
