{
  "expo": {
    "name": "Finance Platform",
    "slug": "finance-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "packagerOpts": {
      "sourceExts": ["js", "jsx", "ts", "tsx"]
    },
    "android": {
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "POST_NOTIFICATIONS"],
      "package": "com.financeplatform.mobile"
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8000"
    }
  }
}
